{
  "name": "growmory",
  "version": "0.1.0",
  "description": "Local-first app portfolio management & ASO studio for indie makers and developers.",
  "private": true,
  "license": "MIT",
  "author": "SuYue1093",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuYue1093/Growmory.git"
  },
  "homepage": "https://github.com/SuYue1093/Growmory#readme",
  "bugs": {
    "url": "https://github.com/SuYue1093/Growmory/issues"
  },
  "keywords": [
    "indie-hacker",
    "app-store-connect",
    "aso",
    "local-first",
    "sqlite",
    "mcp",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "start:macos": "bash scripts/start-macos.command",
    "start:windows": "scripts\\start-windows.bat",
    "dev:sandbox": "bash scripts/test-sandbox.sh --server",
    "test:sandbox": "bash scripts/test-sandbox.sh",
    "aso:studio": "node scripts/aso-screenshot-studio.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/bundler": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
