    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remotion": "^4.0.543",
    "unified": "^11.0.5",
    "unzipper": "^0.10.14",
    "zod": "^3.25.76"
  },
