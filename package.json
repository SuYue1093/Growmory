    "@tiptap/markdown": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "app-store-scraper": "^0.18.0",
    "diff": "^8.0.2",
    "exceljs": "^4.4.0",
    "fast-csv": "^4.3.6",
    "hls.js": "^1.7.4",
    "i18n-iso-countries": "^7.14.0",
    "jszip": "^3.10.1",
