# ==========================================
# Growmory 基础配置
# ==========================================
PORT=5173

# ==========================================
# 本地 / 外部 AI 服务配置（可选）
# 仅在本机后端使用，密钥不会泄露至前端浏览器。兼容 OpenAI Chat Completions 规范。
# 也支持在工作台的“设置 -> AI 模型”界面直接配置与连接测试。
# ==========================================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# ==========================================
# 个人主页 / 独立作品站同步配置（可选）
# 用于将 Growmory 中的营销文章一键同步与构建至个人独立站点。
# ==========================================
# 个人站点绑定域名（例如 yourdomain.com）
PERSONAL_SITE_DOMAIN=example.com
# 个人站点本地源码绝对路径或相对路径（默认检测相邻目录）
# PERSONAL_SITE_PATH=/path/to/your/site
# 文章阅读量与访客统计读取接口（可选）
# PERSONAL_SITE_METRICS_URL=https://yourdomain.com/journal-metrics/counts
# PERSONAL_SITE_METRICS_TOKEN=
# 设为 1 时，允许在 Growmory 中触发线上部署脚本
PERSONAL_SITE_DEPLOY=0
# 文章署名作者名称
PERSONAL_SITE_AUTHOR=Growmory

# ==========================================
# 百度统计 OpenAPI 配置（可选）
# 如需在独立站点概览中同步百度统计数据，可在此配置或通过界面授权
# ==========================================
BAIDU_TONGJI_API_KEY=
BAIDU_TONGJI_SECRET_KEY=
BAIDU_TONGJI_SITE_ID=
